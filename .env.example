DATABASE_URL=postgresql://noah:noah@localhost:5432/noah
DB_MODE=local
# LOCAL_DATABASE_URL=file:/absolute/path/to/demo.db
NEWS_PROVIDER=mock
AI_PROVIDER=mock
# For live RSS source-link-only beta: set AI_PROVIDER=off; only 'collect' pipeline allowed.
# No AI Brief or Event publication is performed in this mode.
SOURCE_LINKS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NEWS_API_KEY=
RSS_FEEDS=
OFFICIAL_RSS_FEEDS=
CRON_SECRET=
ADMIN_SECRET=
APP_URL=http://localhost:3000

# Internal AI News Partner lab (default OFF; never enabled in production)
# Only locally or on Vercel PREVIEW; no public release.
# An OPENAI_API_KEY is an API-billed key; ChatGPT subscription does not include it.
# Before enabling: create a restricted OpenAI API project and confirm its actual billing safeguards.
# Dashboard budgets/alerts may NOT impose a strict hard cutoff; monitor billed usage.
NOAH_READER_LAB_ENABLED=false
NOAH_READER_LAB_ACCESS_TOKEN=
NOAH_READER_LAB_MODEL=gpt-4.1-mini

# Production-parity REAL RSS in nonproduction preview, opt-in only.
# Set NEWS_PROVIDER=government + AI_PROVIDER=off on the same preview deployment.
# This reuses the IDENTICAL actual ministry collector and UI as production.
NOAH_REAL_SOURCE_PREVIEW=false
# Preview requires 1-10 unique SHA256 digests, generated locally via:
# node scripts/generate-reader-invites.mjs
# Raw invitation codes are given privately to testers. Do NOT store them here.
NOAH_READER_LAB_INVITE_HASHES=
